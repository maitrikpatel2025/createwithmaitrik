# ============================================================================
# Multi-Agent Orchestration - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Anthropic API Key (REQUIRED)
# Get from: https://console.anthropic.com/
# Used for orchestrator agent and all command agents
ANTHROPIC_API_KEY=

# PostgreSQL Connection String (REQUIRED)
#
# NeonDB Example (recommended - free tier available):
#   DATABASE_URL=postgresql://username:password@ep-xxx-xxx.aws.neon.tech/neondb?sslmode=require
#
# Docker Example:
#   DATABASE_URL=postgresql://postgres:mypassword@localhost:5432/orchestrator
#
# Local PostgreSQL Example:
#   DATABASE_URL=postgresql://localhost:5432/orchestrator
#
# Get NeonDB connection string from: https://console.neon.tech
DATABASE_URL=










# ============================================================================
# OPTIONAL CONFIGURATION (All values below have sensible defaults)
# ============================================================================

# ============================================================================
# ADDITIONAL API KEYS (OPTIONAL)
# ============================================================================

# Optional: Additional AI provider API keys (if you want to use them)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Optional: NeonDB API Key (for programmatic database management)
NEON_DB_API_KEY=

# ============================================================================
# DATABASE CONFIGURATION (OPTIONAL)
# ============================================================================

# Database connection pool settings (defaults shown)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# BACKEND CONFIGURATION (OPTIONAL)
# ============================================================================

# Backend server host and port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=9403

# ============================================================================
# FRONTEND CONFIGURATION (OPTIONAL)
# ============================================================================

# Frontend dev server host and port
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5175

# API base URL for frontend to connect to backend
VITE_API_BASE_URL=http://127.0.0.1:9403

# ============================================================================
# WEBSOCKET CONFIGURATION (OPTIONAL)
# ============================================================================

# WebSocket URL (automatically constructed from backend host:port)
WEBSOCKET_URL=ws://127.0.0.1:9403/ws

# ============================================================================
# ORCHESTRATOR AGENT CONFIGURATION (OPTIONAL)
# ============================================================================

# Model for orchestrator agent
# Options: claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001
ORCHESTRATOR_MODEL=claude-sonnet-4-5-20250929

# Working directory for orchestrator and created agents
# Leave empty to use project root, or specify absolute path
ORCHESTRATOR_WORKING_DIR=

# ============================================================================
# COMMAND AGENT CONFIGURATION (OPTIONAL)
# ============================================================================

# Default model for command agents created by orchestrator
# Options: claude-sonnet-4-5-20250929, claude-haiku-4-5-20251001
DEFAULT_AGENT_MODEL=claude-sonnet-4-5-20250929

# Fast model for AI summarization and quick tasks
FAST_MODEL=claude-haiku-4-5-20251001

# System prompt template for managed agents (relative to backend directory)
AGENT_SYSTEM_PROMPT_TEMPLATE_PATH=

# Maximum turns for agent execution before stopping
MAX_AGENT_TURNS=500

# ============================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for hourly rotating log files (relative to backend directory)
LOG_DIR=backend/logs

# ============================================================================
# QUERY LIMITS (OPTIONAL)
# ============================================================================

# Default limits for database queries (pagination)
DEFAULT_AGENT_LOG_LIMIT=50
DEFAULT_SYSTEM_LOG_LIMIT=50
DEFAULT_CHAT_HISTORY_LIMIT=300

# ============================================================================
# CORS CONFIGURATION (OPTIONAL)
# ============================================================================

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

# ============================================================================
# IDE INTEGRATION (OPTIONAL)
# ============================================================================

# IDE command for opening files from UI (supports 'cursor' or 'code')
IDE_COMMAND=code
IDE_ENABLED=true

# ============================================================================
# INSTAGRAM GRAPH API (OPTIONAL)
# ============================================================================
# Enables live follower count and impressions on the homepage StatsBar.
#
# Setup:
# 1. Go to https://developers.facebook.com/ and create a Meta App
# 2. Add the "Instagram Graph API" product
# 3. Connect your Instagram Business or Creator account
# 4. Generate a long-lived access token (valid 60 days)
# 5. Find your IG User ID via the API Explorer
#
# Token refresh: GET https://graph.facebook.com/v21.0/oauth/access_token
#   ?grant_type=fb_exchange_token&client_id=APP_ID
#   &client_secret=APP_SECRET&fb_exchange_token=CURRENT_TOKEN

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ============================================================================
# BEEHIIV NEWSLETTER
# ============================================================================
# Handles newsletter + lead-magnet email subscriptions.
#
# Setup:
# 1. Sign up at beehiiv.com
# 2. Go to Settings → Integrations → API
# 3. Create an API key
# 4. Copy your Publication ID from Settings → General

BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ============================================================================
# SMTP (SERVICE INQUIRY NOTIFICATIONS)
# ============================================================================
# Sends you an email when someone submits the services inquiry form.
#
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-app-password (NOT your login password)
#   Generate app password: myaccount.google.com → Security → App Passwords
#
# For other providers: use their SMTP settings

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_NOTIFY_EMAIL=hello@maitrikpatel.io

# ============================================================================
# CLOUDFLARE R2 STORAGE (REQUIRED FOR PRODUCTION)
# ============================================================================
# Stores all media uploads (images, PDFs, videos) in Cloudflare R2.
# When these vars are absent, Payload falls back to local disk (public/media).
#
# Setup:
# 1. Go to https://dash.cloudflare.com → R2 Object Storage
# 2. Create a bucket (e.g. "createwithmaitrik-media")
# 3. Go to R2 → Manage R2 API Tokens → Create API Token
#    - Permissions: Object Read & Write
#    - Specify bucket: your bucket name
# 4. Copy the Access Key ID, Secret Access Key, and endpoint URL
# 5. (Optional) Add a custom domain or use the R2.dev subdomain for public access

R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Public URL prefix for serving files (custom domain or R2.dev subdomain)
# Example: https://media.maitrikpatel.io  or  https://pub-xxx.r2.dev
R2_PUBLIC_URL=
